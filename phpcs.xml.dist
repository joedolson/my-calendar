<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Plugins">
	<description>Generally-applicable sniffs for WordPress plugins</description>
	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress.WP.I18n" />
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="mc_add_events"/>
				<element value="mc_publish_events"/>
				<element value="mc_approve_events"/>
				<element value="mc_manage_events"/>
				<element value="mc_edit_locations"/>
				<element value="mc_edit_categories"/>
				<element value="mc_edit_styles"/>
				<element value="mc_manage_scripts"/>
				<element value="mc_edit_templates"/>
				<element value="mc_edit_settings"/>
				<element value="mc_view_help"/>
			</property>
		</properties>
	</rule>
	<config name="text_domain" value="my-calendar" />

	<!-- Check all PHP files in directory tree by default. -->
	<arg name="extensions" value="php"/>
	<file>.</file>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Show progress and sniff codes in all reports -->
	<arg value="ps"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/action-scheduler/*</exclude-pattern>
</ruleset>
